FROM python:3.11-slim

WORKDIR /app

# Install build dependencies needed for psycopg2 compilation and health checks
RUN apt-get update && apt-get install -y \
    gcc \
    build-essential \
    libpq-dev \
    libssl-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-frozen.txt .
# Set LDFLAGS and CFLAGS so psycopg2 can find SSL libraries during compilation
RUN LDFLAGS="-L/usr/lib/x86_64-linux-gnu" CFLAGS="-I/usr/include" \
    pip install --no-cache-dir -r requirements-frozen.txt

COPY . .

ENV FLASK_APP=leaf_api.app:create_app
ENV FLASK_ENV=development

EXPOSE 5000

CMD ["flask", "run", "--host=0.0.0.0"]
